# LENZI — public web configuration
# Copy to apps/web/.env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LANGUAGE=sw
NEXT_PUBLIC_DEMO_MODE=false

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY
LENZI_ADMIN_BOOTSTRAP_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_VALUE

# Mobile build-time values (pass with --dart-define)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# LENZI_DEMO=false
